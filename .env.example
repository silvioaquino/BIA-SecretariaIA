# Copie para .env.local (o app) e .env (a CLI do Prisma). Nunca envie esses arquivos para o git.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # ou a anon key

# Supabase → Connect → ORMs → Prisma
# pooler (porta 6543), usado pelo app:
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# conexão direta / session pooler (porta 5432), usada pelo prisma migrate:
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Asaas → Integrações → Chave de API (comece pelo SANDBOX: chave $aact_hmlg_...)
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
# Token que você inventa e cola na configuração do webhook do Asaas (não use a chave de API)
ASAAS_WEBHOOK_TOKEN=
# UNDEFINED = Pix pelo QR + cartão/boleto na fatura · PIX = só Pix
ASAAS_BILLING_TYPE=UNDEFINED

# Dias de atraso antes de pausar a Bia
CARENCIA_DIAS=5

# Segredo do cron diário (Vercel envia "Authorization: Bearer CRON_SECRET")
CRON_SECRET=
# Token que o n8n manda no header x-bia-token ao consultar /api/bia/clinica
BIA_API_TOKEN=

APP_URL=http://localhost:3000

# ── Prospecção ──
# Quem entra em /admin/prospeccao (os mesmos e-mails do login), separados por vírgula
ADMIN_EMAILS=
# Google Cloud → APIs → ative "Places API (New)" → Credenciais → Criar chave.
# Restrinja a chave à Places API. 1.000 buscas grátis por mês no SKU usado.
GOOGLE_PLACES_API_KEY=
# Evolution (só para CONFERIR se o número tem WhatsApp; nada é enviado). Opcional.
EVOLUTION_URL=   # endereço da Evolution da wanderingechidna
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=            # instância que CONFERE números e MANDA os avisos para a equipe
# Etapa 3: respostas das clínicas
EVOLUTION_INSTANCIA_COMERCIAL=  # instância do WhatsApp comercial (a que recebe as respostas)
EVOLUTION_WEBHOOK_TOKEN=        # texto aleatório; vai na URL do webhook (?token=)
# Se o número comercial também alimenta outro fluxo (ex.: a demo no n8n), cada evento é repassado para cá
EVOLUTION_REPASSAR_URL=
ALERTA_WHATSAPP=                # números da equipe que recebem os avisos (55+DDD+número, separados por vírgula)

# Opcional: WhatsApp comercial (55 + DDD + número). Se preenchido, a landing mostra "Tirar dúvidas no WhatsApp".
NEXT_PUBLIC_WHATSAPP_VENDAS=
